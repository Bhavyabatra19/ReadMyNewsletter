# Copy this file to `.env` and fill in your values, then:
#   set -a && source .env && set +a && python newsletter_digest.py
# (or use a tool like direnv / dotenv). NEVER commit the real .env file.

# --- Your dedicated newsletter inbox (IMAP) ---
IMAP_HOST=imap.gmail.com          # Gmail: imap.gmail.com | Outlook: outlook.office365.com | Yahoo: imap.mail.yahoo.com | Proton: 127.0.0.1 (Bridge)
IMAP_PORT=993
IMAP_USER=your.newsletters@gmail.com
IMAP_PASSWORD=your_app_password   # NOT your normal password — see README (app password / 2FA)
IMAP_FOLDER=INBOX

# --- Claude summaries (optional but recommended) ---
# Get a key at console.anthropic.com. Leave blank to run in --no-ai mode.
ANTHROPIC_API_KEY=
DIGEST_MODEL=claude-haiku-4-5-20251001

# --- Output ---
DIGEST_OUTPUT_DIR=digests
